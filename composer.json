{
    "name": "thoughtco/statamic-plausible-analytics",
    "description": "Get your Plausible Analytics data right from your Statamic dashboard.",
    "autoload": {
        "psr-4": {
            "Thoughtco\\Plausible\\": "src"
        }
    },
    "authors": [
        {
            "name": "Jack Whiting",
            "email": "hi@jackwhiting.co.uk",
            "homepage": "https://jackwhiting.co.uk",
            "role": "Developer"
        },
        {
            "name": "Thought Collective",
            "email": "hello@thoughtcollective.com",
            "homepage": "https://www.thoughtcollective.com",
            "role": "Developer"
        }
    ],
    "extra": {
        "download-dist": {
            "path": "dist",
            "url": "https://github.com/thoughtco/statamic-plausible-analytics/releases/download/{$version}/dist.tar.gz"
        },
        "statamic": {
            "name": "Plausible Analytics",
            "description": "Get your Plausible Analytics data right from your Statamic dashboard"
        },
        "laravel": {
            "providers": [
                "Thoughtco\\Plausible\\PlausibleServiceProvider"
            ]
        }
    },
    "require": {
        "guzzlehttp/guzzle": "^7.2",
        "pixelfear/composer-dist-plugin": "^0.1.6",
        "statamic/cms": "^6.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "require-dev": {
        "laravel/pint": "^1.27"
    }
}
